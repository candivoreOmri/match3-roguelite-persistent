{
  "version": "0.0.1",
  "_comment": [
    "Serves /private/tmp/ascent-serve (populated by `sh sync.sh`) — the browser",
    "sandbox cannot read ~/Desktop (macOS TCC), so we serve a copy. The command",
    "reads $PORT (autoPort may reassign); -b 127.0.0.1 keeps it localhost-only.",
    "Same pattern as claudeTest/.claude/launch.json."
  ],
  "configurations": [
    {
      "name": "ascent",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "exec ruby -run -e httpd /private/tmp/ascent-serve -b 127.0.0.1 -p \"${PORT:-8940}\""],
      "port": 8940,
      "autoPort": true
    }
  ]
}
